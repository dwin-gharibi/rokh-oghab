{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Rokh Oghab Helm values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "podCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "podCidrs6": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "explicit",
            "transparent_http",
            "transparent_tls"
          ]
        },
        "config": {
          "type": "object",
          "properties": {
            "strict": {
              "type": "object",
              "properties": {
                "minTlsVersion": {
                  "type": "string",
                  "enum": [
                    "1.0",
                    "1.1",
                    "1.2",
                    "1.3"
                  ]
                },
                "tlsPorts": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "dns": {
              "type": "object",
              "properties": {
                "denyResponse": {
                  "type": "string",
                  "enum": [
                    "nxdomain",
                    "refused",
                    "servfail"
                  ]
                }
              }
            },
            "identities": {
              "type": "object",
              "properties": {
                "allowAnonymous": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "admin": {
          "type": "object",
          "properties": {
            "public": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "healthz",
                  "readyz",
                  "metrics"
                ]
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hook": {
          "type": "string",
          "enum": [
            "forward",
            "output",
            "both"
          ]
        },
        "blockIPv6": {
          "type": "boolean"
        },
        "transparent": {
          "type": "boolean"
        },
        "ipv6Unscoped": {
          "type": "string",
          "enum": [
            "refuse",
            "allow"
          ]
        },
        "flushConntrack": {
          "type": "boolean"
        },
        "bootstrapDeny": {
          "type": "boolean"
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failClosed": {
          "type": "boolean"
        },
        "signBundles": {
          "type": "boolean"
        },
        "requireSignature": {
          "type": "boolean"
        },
        "pollSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "acceptSigningKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "sampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trustIncomingTrace": {
          "type": "boolean"
        },
        "recordDestination": {
          "type": "boolean"
        }
      }
    }
  }
}