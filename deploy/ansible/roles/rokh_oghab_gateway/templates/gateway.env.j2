RO_NODE={{ ro_gateway_node_name }}
RO_CONFIG={{ ro_gateway_config_dir }}/gateway.json
RO_BUNDLE_FILE={{ ro_gateway_config_dir }}/bundle.json
RO_ADMIN_TOKEN={{ ro_gateway_admin_token }}
RO_ADMIN_OPERATOR_TOKEN={{ ro_gateway_admin_operator_token }}
RO_ADMIN_READER_TOKEN={{ ro_gateway_admin_reader_token }}
RO_ADMIN_PUBLIC={{ ro_gateway_admin_public | join(',') }}
RO_OTEL_ENABLED={{ ro_gateway_otel_enabled | lower }}
RO_OTEL_ENDPOINT={{ ro_gateway_otel_endpoint }}
RO_OTEL_SERVICE_NAME={{ ro_gateway_otel_service_name }}
RO_OTEL_SAMPLE_RATIO={{ ro_gateway_otel_sample_ratio }}
{% if ro_gateway_controller_url | length > 0 %}
RO_CONTROLLER_URL={{ ro_gateway_controller_url }}
RO_CONTROLLER_TOKEN={{ ro_gateway_controller_token }}
{% if ro_gateway_controller_signing_key | length > 0 %}
RO_CONTROLLER_SIGNING_KEY={{ ro_gateway_controller_signing_key }}
RO_CONTROLLER_REQUIRE_SIGNATURE={{ ro_gateway_controller_require_signature | lower }}
{% if ro_gateway_controller_accept_signing_keys | length > 0 %}
RO_CONTROLLER_ACCEPT_SIGNING_KEYS={{ ro_gateway_controller_accept_signing_keys | join(',') }}
{% endif %}
{% endif %}
{% endif %}
