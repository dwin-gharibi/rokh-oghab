RO_GATEWAY_ADDR={{ ro_agent_gateway_addr }}
RO_PROXY_PORT={{ ro_agent_proxy_port }}
RO_DNS_PORT={{ ro_agent_dns_port }}
RO_SANDBOX_CIDRS={{ ro_agent_sandbox_cidrs | join(',') }}
{% if ro_agent_allow_cidrs | length > 0 %}
RO_ALLOW_CIDRS={{ ro_agent_allow_cidrs | join(',') }}
{% endif %}
{% if ro_agent_sandbox_ifaces | length > 0 %}
RO_SANDBOX_IFACES={{ ro_agent_sandbox_ifaces | join(',') }}
{% endif %}
RO_HOOK={{ ro_agent_hook }}
RO_BLOCK_IPV6={{ ro_agent_block_ipv6 | lower }}
RO_TRANSPARENT={{ ro_agent_transparent | lower }}
RO_DNS_REDIRECT={{ ro_agent_dns_redirect | lower }}
RO_LOG_DROPS={{ ro_agent_log_drops | lower }}
RO_RECONCILE_SECONDS={{ ro_agent_reconcile_seconds }}
RO_ENFORCE_RP_FILTER=true
