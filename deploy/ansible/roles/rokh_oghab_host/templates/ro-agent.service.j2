[Unit]
Description=Rokh Oghab node egress enforcement
Documentation=https://github.com/dwin-gharibi/rokh-oghab
After=network-pre.target nftables.service
Wants=network-pre.target
Before=docker.service kubelet.service

[Service]
Type=simple
EnvironmentFile=/etc/default/ro-agent
ExecStartPre={{ ro_agent_binary_dest }} check
ExecStart={{ ro_agent_binary_dest }} run
ExecStop={{ ro_agent_binary_dest }} flush
Restart=always
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
