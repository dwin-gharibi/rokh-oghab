RO_CONTROLLER_CONFIG={{ ro_controller_config_dir }}/controller.json
RO_CONTROLLER_DATA_DIR=/var/lib/rokh-oghab
RO_CONTROLLER_ADMIN_TOKEN={{ ro_controller_admin_token }}
{% if ro_controller_operator_token | length > 0 %}
RO_CONTROLLER_OPERATOR_TOKEN={{ ro_controller_operator_token }}
{% endif %}
{% if ro_controller_reader_token | length > 0 %}
RO_CONTROLLER_READER_TOKEN={{ ro_controller_reader_token }}
{% endif %}
RO_CONTROLLER_GATEWAY_TOKEN={{ ro_controller_gateway_token }}
{% if ro_controller_bundle_signing_key | length > 0 %}
RO_CONTROLLER_BUNDLE_SIGNING_KEY={{ ro_controller_bundle_signing_key }}
{% endif %}
